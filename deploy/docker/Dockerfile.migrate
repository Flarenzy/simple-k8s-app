FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder

WORKDIR /src
ARG TARGETOS=linux
ARG TARGETARCH

RUN apk add --no-cache ca-certificates git

RUN mkdir -p /out \
    && CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-$(go env GOARCH)} \
    go install github.com/pressly/goose/v3/cmd/goose@latest \
    && goose_path="$(go env GOPATH)/bin/goose" \
    && if [ ! -x "$goose_path" ]; then \
         goose_path="$(go env GOPATH)/bin/${TARGETOS:-linux}_${TARGETARCH:-$(go env GOARCH)}/goose"; \
       fi \
    && test -x "$goose_path" \
    && cp "$goose_path" /out/goose

FROM alpine:3.23 AS runner

WORKDIR /app

RUN apk add --no-cache ca-certificates

COPY --from=builder /out/goose /usr/local/bin/goose
COPY db/migrations /migrations

ENTRYPOINT ["/bin/sh", "-c"]
CMD ["/usr/local/bin/goose -dir /migrations postgres \"$DB_CONN\" up"]
