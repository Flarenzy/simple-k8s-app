{
  "realm": "ipam-integration",
  "enabled": true,
  "clients": [
    {
      "clientId": "ipam-api",
      "name": "IPAM API",
      "bearerOnly": true
    },
    {
      "clientId": "ipam-test",
      "name": "IPAM Integration Tests",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-ipam-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ipam-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "ipam-api": [
        { "name": "admin" },
        { "name": "read-only" },
        { "name": "editor" }
      ]
    }
  },
  "users": [
    {
      "username": "integration-user",
      "enabled": true,
      "firstName": "Integration",
      "lastName": "User",
      "email": "integration-user@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "integration-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "ipam-api": ["admin"]
      }
    },
    {
      "username": "integration-reader",
      "enabled": true,
      "firstName": "Integration",
      "lastName": "Reader",
      "email": "integration-reader@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "integration-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "ipam-api": ["read-only"]
      }
    },
    {
      "username": "integration-editor",
      "enabled": true,
      "firstName": "Integration",
      "lastName": "Editor",
      "email": "integration-editor@example.com",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "integration-password",
          "temporary": false
        }
      ],
      "clientRoles": {
        "ipam-api": ["editor"]
      }
    }
  ]
}
