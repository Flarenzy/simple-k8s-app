                    }
                },
                "subnet_id": {
                    "type": "integer",
                    "example": 4
                },
                "updated_at": {
                    "type": "string",
                    "example": "2024-05-10T15:04:05Z"
                }
            }
        },
        "http.ImportResponse": {
            "type": "object",
            "properties": {
                "created": {
                    "type": "integer"
                },
                "errors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/http.RowError"
                    }
                },
                "failed": {
                    "type": "integer"
                },
                "processed": {
                    "type": "integer"
                },
                "updated": {
                    "type": "integer"
                }
            }
        },
