{
  "realm": "ipam",
  "enabled": true,
  "clients": [
    {
      "clientId": "ipam-api",
      "name": "IPAM API",
      "bearerOnly": true
    },
    {
      "clientId": "ipam-fe",
      "name": "IPAM Frontend",
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "redirectUris": [
        "https://ipam.local/*",
        "http://simplek8sapp.lan/*",
        "https://simplek8sapp.lan/*"
      ],
      "webOrigins": [
        "https://ipam.local",
        "http://simplek8sapp.lan",
        "https://simplek8sapp.lan"
      ],
      "protocolMappers": [
        {
          "name": "aud-ipam-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ipam-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "client": {
      "ipam-api": [
        { "name": "admin", "description": "Full access to IPAM" },
        { "name": "read-only", "description": "Read-only access to IPAM" },
        { "name": "editor", "description": "Read, create, and edit access without delete" }
      ]
    }
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "IPAM",
      "lastName": "Administrator",
      "email": "admin@ipam.local",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${IPAM_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "ipam-api": ["admin"]
      }
    }
  ]
}
